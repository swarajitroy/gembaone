{
  "api_base_path": "/v1",
  "auth": {
    "login_endpoint": "/v1/auth/login",
    "login_request": {
      "field_names": ["email", "password"]
    },
    "login_response": {
      "token_field": "access_token",
      "user_field": "user"
    },
    "header_format": "Bearer {token}",
    "storage_key": "access_token"
  },
  "pagination": {
    "wrapper": {
      "items": "array",
      "total": "integer",
      "page": "integer",
      "page_size": "integer"
    },
    "default_page_size": 20
  }
}
